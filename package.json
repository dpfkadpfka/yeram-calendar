{
  "name": "yeram-calendar",
  "productName": "RamCalendar",
  "version": "1.2.19",
  "description": "구글 캘린더와 연동되는 바탕화면 달력",
  "main": "main.js",
  "author": "김예람",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "jszip": "^3.10.1",
    "koffi": "^2.16.3",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.yeram.calendar",
    "productName": "RamCalendar",
    "executableName": "RamCalendar",
    "copyright": "© 김예람",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "creds.json",
      "package.json",
      "!node_modules/koffi/build/koffi/{darwin*,freebsd*,linux*,openbsd*,musl*,win32_arm64,win32_ia32}/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RamCalendar-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RamCalendar",
      "uninstallDisplayName": "RamCalendar",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
